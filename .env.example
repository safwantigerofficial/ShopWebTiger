# Supabase — same project the bot uses (read/write via same tables & RPCs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Login — the NEW empty login bot (never the main bot token)
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=your_login_bot_username

# Shop bot public username — only used to build referral links (https://t.me/<bot>?start=<code>)
MAIN_BOT_USERNAME=SafwanTigerShopBot

# CryptoBot (@CryptoBot) top-ups — same token the bot uses
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_BASE_URL=https://pay.crypt.bot

# Buff Token: no env needed — TunVN credentials come from supplier_api_sources in Supabase (same as bot)

# iron-session cookie secret — any random 32+ char string
SESSION_SECRET=

# Admin Telegram user id (optional)
ADMIN_USER_ID=

# Public site URL (optional, for future callbacks)
SITE_URL=
